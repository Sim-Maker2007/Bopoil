{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/operations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/square",
      "schedule": "7 * * * *"
    }
  ]
}
