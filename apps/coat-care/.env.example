# Vercel runtime foundation
# Supabase Postgres is the durable database used by the Vercel Functions.
# Use the pooled connection string (Supavisor, port 6543) from
# Supabase -> Project Settings -> Database -> Connection string.
# Local development expects any reachable Postgres, e.g.:
#   postgres://postgres:postgres@127.0.0.1:5432/coat_care
DATABASE_URL=
# Private Vercel Blob store for pet photos, vaccination files, and receipts.
BLOB_READ_WRITE_TOKEN=
# First owner allowed to request a sign-in link before onboarding creates staff records.
SALON_OWNER_EMAIL=info@bopoil.ca
AUTH_HASH_SECRET=
# Vercel Cron sends this value as an Authorization bearer token.
CRON_SECRET=

# Email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# SMS delivery (Twilio Messaging Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Canonical HTTPS production origin; used for provider callbacks and fresh portal links at delivery time.
DELIVERY_PUBLIC_URL=

# Square Appointments (read-only scheduling source)
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Exact public webhook URL registered in Square; defaults to DELIVERY_PUBLIC_URL + /api/webhooks/square.
SQUARE_WEBHOOK_NOTIFICATION_URL=
# Optional override; the integration is pinned to 2026-07-15 by default.
SQUARE_API_VERSION=2026-07-15
SQUARE_ORGANIZATION_SLUG=bopoil
SQUARE_LOCATION_SLUG=gatineau
SQUARE_LOCATION_ID=
# Comma-separated exact website origins allowed to submit the public intake form.
PUBLIC_INTAKE_ALLOWED_ORIGINS=https://bopoil.ca,https://www.bopoil.ca

# Stripe Connect, hosted checkout, and SaaS subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_APPLICATION_FEE_BPS=0
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_MULTI_PRICE_ID=
